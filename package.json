{
  "name": "poipoihisab-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @poipoihisab/web dev",
    "build:web": "pnpm --filter @poipoihisab/web build",
    "test:web": "pnpm --filter @poipoihisab/web test",
    "lint:web": "pnpm --filter @poipoihisab/web lint",
    "typecheck:web": "pnpm --filter @poipoihisab/web typecheck",
    "typecheck:mobile": "pnpm --filter @poipoihisab/mobile typecheck",
    "test:core": "pnpm --filter @poipoihisab/core test",
    "generate:client": "pnpm --filter @poipoihisab/api-client generate",
    "lint:api": "uv --directory apps/api run ruff check app tests",
    "test:api": "uv --directory apps/api run pytest -q",
    "openapi": "uv --directory apps/api run python scripts/dump_openapi.py",
    "audit": "node scripts/audit.mjs",
    "test:audits": "node --test scripts/tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "wip": "node scripts/wip-snapshot.mjs",
    "verify": "pnpm test:audits && node scripts/audit.mjs && pnpm typecheck:web && pnpm typecheck:mobile && pnpm lint:web && pnpm test:core && pnpm test:web && pnpm lint:api && pnpm test:api"
  }
}
