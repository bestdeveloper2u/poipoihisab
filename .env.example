# Poi Poi Hisab — every variable this codebase reads.
#
# `audit-env.mjs` checks this file against the code IN BOTH DIRECTIONS, so a
# variable added here without a reader fails the build, and so does a reader
# with no entry here. Copy to `.env` (API, read by pydantic-settings) or
# `.env.local` (web, read by Vite) and fill in real values.

# ── API (apps/api) ────────────────────────────────────────────────────────────
# Field names come from Settings in apps/api/app/core/config.py; the
# POIPOIHISAB_ prefix and case-insensitive matching are set in its model_config.

# local | prod | production. Anything but local makes JWT_SECRET mandatory.
POIPOIHISAB_ENV=local

# Async SQLAlchemy URL. Default is a local SQLite file; production is Supabase
# Postgres. Use the TRANSACTION POOLER host on serverless — a direct connection
# exhausts its slots, and session.py switches off the asyncpg statement cache
# when it sees a pooler host.
POIPOIHISAB_DATABASE_URL=sqlite+aiosqlite:///./poipoihisab.db

# HS256 signing secret, 64+ chars. REQUIRED when ENV is prod: config.py raises
# rather than booting. Left empty locally an ephemeral one is generated, so
# every restart invalidates issued tokens.
POIPOIHISAB_JWT_SECRET=

# Sessions, the per-user session index, and brute-force counters.
# EMPTY IS DANGEROUS IN PRODUCTION: the app falls back to in-process MemoryKV,
# so on serverless every cold start signs all users out and resets the rate
# limiter — with no error anywhere. Set it to the Postgres URL above or a Redis
# URL. /admin/system reports which backend is live.
POIPOIHISAB_KV_URL=

# JSON array or comma-separated list of browser origins allowed to call the API.
POIPOIHISAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Comma-separated emails granted superadmin regardless of the database flag.
# This is deployment config, not a durable record: if it changes and no account
# carries profiles.is_superadmin, nobody can reach /admin. /admin/roles warns.
POIPOIHISAB_SUPERADMIN_EMAILS=you@example.com

# 0 only for the plain-http test client. Production keeps the refresh cookie Secure.
POIPOIHISAB_REFRESH_COOKIE_SECURE=1

# Access-token lifetime (s) and refresh-token/session lifetime (s).
POIPOIHISAB_ACCESS_TTL=900
POIPOIHISAB_REFRESH_TTL=2592000

# Failed credential attempts allowed per minute, per IP+email bucket.
POIPOIHISAB_AUTH_RATE_LIMIT=5

# Google service-account JSON: a file path locally, the JSON inline on Vercel
# (serverless has no persistent filesystem). Empty disables Sheets sync for
# everyone; /admin/integrations reports it.
POIPOIHISAB_GOOGLE_SHEETS_SA_FILE=

# API version override for /healthz and /admin/system. Defaults from config.py.
# Web/mobile labels are build metadata, not affected by this runtime override.
POIPOIHISAB_APP_NAME=Poi Poi Hisab API
POIPOIHISAB_VERSION=0.28.0

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# EMPTY ON PURPOSE, and it must stay empty in production. An empty base URL
# makes every call relative (/api/v1/*), which is what keeps the API
# same-origin — required by the SameSite=Lax refresh cookie and by the
# connect-src 'self' CSP in vercel.json. See closed decision D2 in ROADMAP.md.
VITE_API_URL=

# ── Mobile (apps/mobile) ─────────────────────────────────────────────────────
# Expo inlines EXPO_PUBLIC_* at build time. The mobile client is not a browser
# and authenticates with a Bearer token, so it may point at an absolute origin.
EXPO_PUBLIC_API_URL=https://poipoihisab.com/api
